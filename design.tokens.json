{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "deepNavy": {"$type": "color", "$value": "#06235D"},
    "signalBlue": {"$type": "color", "$value": "#0183E0"},
    "electricCyan": {"$type": "color", "$value": "#09CEFC"},
    "cloudWhite": {"$type": "color", "$value": "#F8FAFC"},
    "slate": {"$type": "color", "$value": "#64748B"}
  },
  "radius": {
    "card": {"$type": "dimension", "$value": {"value": 14, "unit": "px"}},
    "control": {"$type": "dimension", "$value": {"value": 9, "unit": "px"}}
