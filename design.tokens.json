  "fontFamily": {
    "sans": {"$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]},
    "mono": {"$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"]}
  }
